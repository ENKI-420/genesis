# GENESIS Sovereign Platform - Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Configuration file path
GENESIS_CONFIG_PATH=config/default.yaml

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
GENESIS_LOG_LEVEL=INFO

# Log file path (empty for stdout only)
GENESIS_LOG_FILE=

# =============================================================================
# PORTAL SETTINGS
# =============================================================================

# Active portal (enterprise, defense, health, legal, darpa)
GENESIS_PORTAL=enterprise

# Portal server settings
GENESIS_HOST=0.0.0.0
GENESIS_PORT=8080

# =============================================================================
# CLASSIFICATION SETTINGS (Defense/DARPA portals)
# =============================================================================

# Default classification level
GENESIS_CLASSIFICATION=UNCLASSIFIED

# Enable classification enforcement
GENESIS_CLASSIFICATION_ENFORCE=true

# Classification audit logging
GENESIS_CLASSIFICATION_AUDIT=true

# =============================================================================
# CCCE METRICS
# =============================================================================

# Enable CCCE metric tracking
GENESIS_CCCE_ENABLED=true

# CCCE convergence threshold
GENESIS_CCCE_THRESHOLD=0.973

# Metric reporting interval (seconds)
GENESIS_METRICS_INTERVAL=60

# =============================================================================
# AGENT SETTINGS
# =============================================================================

# Enable multi-agent system
GENESIS_AGENTS_ENABLED=true

# AIDEN optimizer
GENESIS_AGENT_AIDEN_ENABLED=true

# AURA geometer
GENESIS_AGENT_AURA_ENABLED=true

# PALS sentinel
GENESIS_AGENT_PALS_ENABLED=true

# CHRONOS temporal
GENESIS_AGENT_CHRONOS_ENABLED=true

# AEGIS security
GENESIS_AGENT_AEGIS_ENABLED=true

# =============================================================================
# MEMORY SETTINGS
# =============================================================================

# Memory persistence path
GENESIS_MEMORY_PATH=./data/memory

# Temporal memory lattice size
GENESIS_MEMORY_LATTICE_SIZE=1024

# Memory kernel decay rate (uses Λ_Φ by default)
# GENESIS_MEMORY_DECAY_RATE=2.176435e-8

# =============================================================================
# EVOLUTION SETTINGS
# =============================================================================

# Default mutation rate
GENESIS_MUTATION_RATE=0.01

# Maximum generations per evolution cycle
GENESIS_MAX_GENERATIONS=1000

# Population size for swarm evolution
GENESIS_POPULATION_SIZE=100

# =============================================================================
# HEALTH PORTAL (HIPAA)
# =============================================================================

# HIPAA compliance mode
GENESIS_HIPAA_MODE=false

# PHI encryption key (generate with: openssl rand -base64 32)
# GENESIS_PHI_KEY=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug mode (enables additional logging and checks)
GENESIS_DEBUG=false

# Enable hot reloading for development
GENESIS_HOT_RELOAD=false

# Test mode (uses in-memory storage)
GENESIS_TEST_MODE=false
